# Optional features only. The sample-data demo needs no credentials.
INSTALL_EXTRAS=
NEO4J_ENABLED=false
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# Optional NVD lookups; bundled CVSS metadata works without a key.
NVD_API_KEY=
# Legacy authentication is not registered in the standalone application.
# Do not add real account/database secrets unless developing that integration.
SUPABASE_DB_URL=
